{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oche HTTP benchmark result",
  "type": "object",
  "required": [
    "timestampUtc",
    "implementation",
    "mode",
    "host",
    "port",
    "endpoint",
    "concurrency",
    "durationSeconds",
    "warmupSeconds",
    "loadGenerator",
    "startupMs",
    "environment"
  ],
  "properties": {
    "timestampUtc": { "type": "string", "format": "date-time" },
    "implementation": { "enum": ["raw_dart_io", "relic", "oche_static"] },
    "mode": { "enum": ["jit", "aot"] },
    "host": { "type": "string" },
    "port": { "type": "integer" },
    "endpoint": { "type": "string" },
    "concurrency": { "type": "integer" },
    "durationSeconds": { "type": "integer" },
    "warmupSeconds": { "type": "integer" },
    "loadGenerator": { "enum": ["oha", "none"] },
    "startupMs": { "type": "number" },
    "environment": {
      "type": "object",
      "required": [
        "operatingSystem",
        "osVersion",
        "architecture",
        "dartVersion",
        "logicalCpuCount",
        "environmentType",
        "loadGenerator"
      ],
      "properties": {
        "operatingSystem": { "type": "string" },
        "osVersion": { "type": "string" },
        "architecture": { "type": "string" },
        "dartVersion": { "type": "string" },
        "cpuModel": { "type": "string" },
        "logicalCpuCount": { "type": "integer", "minimum": 1 },
        "environmentType": { "type": "string" },
        "loadGenerator": { "type": "string" },
        "loadGeneratorVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "suiteRunId",
        "iteration",
        "trialSequence",
        "implementationOrder",
        "implementationPosition",
        "endpointOrder",
        "endpointPosition",
        "cooldownSeconds"
      ],
      "properties": {
        "suiteRunId": { "type": "string" },
        "iteration": { "type": "integer", "minimum": 1 },
        "trialSequence": { "type": "integer", "minimum": 1 },
        "implementationOrder": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "implementationPosition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "endpointOrder": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "endpointPosition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cooldownSeconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "requestsPerSecond": { "type": "number" },
    "successRate": { "type": "number" },
    "latency": {
      "type": "object",
      "properties": {
        "p50Ms": { "type": "number" },
        "p95Ms": { "type": "number" },
        "p99Ms": { "type": "number" }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "idleRssMb": { "type": "number" },
        "peakLoadRssMb": { "type": "number" }
      }
    },
    "cpuUtilizationPercent": { "type": "number" },
    "binarySizeMb": { "type": "number" },
    "unavailableMetrics": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
