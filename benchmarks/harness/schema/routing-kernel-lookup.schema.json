{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oche generated routing-kernel isolated lookup result",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "timestampUtc",
    "candidate",
    "routeCount",
    "queryCount",
    "hitRatio",
    "runtime",
    "binarySizeBytes",
    "configuration",
    "trials",
    "aggregate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "oche-routing-kernel-lookup" },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "candidate": { "enum": ["tree", "indexed"] },
    "routeCount": { "enum": [10, 100, 1000] },
    "queryCount": { "const": 1024 },
    "hitRatio": { "const": 0.9 },
    "runtime": { "type": "string" },
    "binarySizeBytes": { "type": "integer", "minimum": 0 },
    "generatedSourceBytes": { "type": "integer", "minimum": 0 },
    "generatedSourceLines": { "type": "integer", "minimum": 0 },
    "configuration": { "type": "object" },
    "trials": { "type": "array", "minItems": 1 },
    "aggregate": { "type": "object" }
  },
  "additionalProperties": false
}
